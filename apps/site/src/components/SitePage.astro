---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, links, type Locale } from "../content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const homeHref = locale === "zh" ? "/zh/" : "/";
const languageHref = locale === "zh" ? "/" : "/zh/";
const languageCode = locale === "zh" ? "en" : "zh-CN";
const sourceDocsHref = locale === "zh" ? links.readmeZh : links.readme;
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
>
  <a class="skip-link" href="#main">{t.skipLink}</a>

  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href={homeHref} aria-label={t.homeLabel}>
        <img src="/favicon.svg" width="34" height="34" alt="" />
        <span>Crewlight</span>
      </a>

      <nav class="primary-nav" aria-label={t.navigationLabel}>
        {t.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <a
        class="language-link"
        href={languageHref}
        lang={languageCode}
        hreflang={languageCode}
      >
        <span aria-hidden="true">◎</span>{t.languageLabel}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span aria-hidden="true"></span>{t.hero.eyebrow}</p>
        <h1 id="hero-title">
          <span>{t.hero.titleLead}</span>
          <strong>{t.hero.titleEmphasis}</strong>
        </h1>
        <p class="hero-body">{t.hero.body}</p>

        <div class="hero-actions">
          <a
            class="button button--primary"
            href={links.repository}
            target="_blank"
            rel="noreferrer"
          >
            {t.hero.primaryAction}<span aria-hidden="true">↗</span>
          </a>
          <a class="button button--quiet" href="#radar">
            {t.hero.secondaryAction}<span aria-hidden="true">↓</span>
          </a>
        </div>

        <p class="release-note">
          <span class="release-note__dot" aria-hidden="true"></span>
          <span>{t.hero.releaseNote}</span>
          <a href={links.v050Release} target="_blank" rel="noreferrer">
            {t.hero.releaseAction}<span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>

      <figure class="radar-console" aria-labelledby="radar-demo-title">
        <div class="radar-console__glow" aria-hidden="true"></div>
        <div class="console-bar">
          <div class="console-lights" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <p>{t.hero.demoLabel}</p>
          <span class="demo-chip"
            ><i aria-hidden="true"></i>{t.hero.demoLive}</span
          >
        </div>

        <div class="console-summary">
          <div>
            <span class="console-kicker">CREWLIGHT / HOME</span>
            <h2 id="radar-demo-title">{t.hero.demoTitle}</h2>
          </div>
          <div class="radar-orbit" aria-hidden="true">
            <span class="radar-orbit__ring"></span>
            <span class="radar-orbit__sweep"></span>
            <i class="radar-orbit__point radar-orbit__point--one"></i>
            <i class="radar-orbit__point radar-orbit__point--two"></i>
            <i class="radar-orbit__point radar-orbit__point--three"></i>
          </div>
        </div>

        <div class="metric-grid">
          {
            t.hero.metrics.map((metric) => (
              <div class:list={["metric", `metric--${metric.tone}`]}>
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
                <i aria-hidden="true" />
              </div>
            ))
          }
        </div>

        <div class="session-list">
          <div class="session-list__heading">
            <span>{t.hero.sessionsLabel}</span>
            <span aria-hidden="true">STATUS / LAST SIGNAL</span>
          </div>
          {
            t.hero.sessions.map((session) => (
              <article
                class:list={["session-row", `session-row--${session.tone}`]}
              >
                <span class="session-row__signal" aria-hidden="true" />
                <div class="session-row__copy">
                  <div>
                    <span>{session.source}</span>
                    <strong>{session.task}</strong>
                  </div>
                  <small>{session.meta}</small>
                </div>
                <span class="status-chip">{session.status}</span>
              </article>
            ))
          }
        </div>

        <figcaption>
          <span aria-hidden="true">⌁</span>{t.hero.footnote}
        </figcaption>
      </figure>
    </section>

    <section class="fact-strip" aria-label={t.factsLabel}>
      <div class="page-shell fact-grid">
        {
          t.facts.map((fact, index) => (
            <article class="fact-card">
              <span class="fact-card__index" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <span class="fact-card__label">{fact.label}</span>
                <h2>{fact.value}</h2>
                <p>{fact.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--radar page-shell" id="radar">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">
            <span aria-hidden="true"></span>{t.radar.eyebrow}
          </p>
          <h2>{t.radar.title}</h2>
        </div>
        <p>{t.radar.intro}</p>
      </div>

      <div class="attention-grid">
        {
          t.radar.modes.map((mode) => (
            <article
              class:list={["attention-card", `attention-card--${mode.tone}`]}
            >
              <div class="attention-card__topline">
                <span>{mode.index}</span>
                <span>{mode.label}</span>
                <i aria-hidden="true" />
              </div>
              <h3>{mode.title}</h3>
              <p>{mode.body}</p>
              <ul aria-label={mode.label}>
                {mode.states.map((state) => (
                  <li>{state}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--flow" id="flow">
      <div class="page-shell flow-layout">
        <div class="flow-intro">
          <p class="eyebrow eyebrow--dark">
            <span aria-hidden="true"></span>{t.flow.eyebrow}
          </p>
          <h2>{t.flow.title}</h2>
          <p>{t.flow.intro}</p>
          <a
            class="text-link text-link--dark"
            href={links.architecture}
            target="_blank"
            rel="noreferrer"
          >
            {t.flow.architectureAction}<span aria-hidden="true">↗</span>
          </a>
        </div>

        <ol class="flow-steps">
          {
            t.flow.steps.map((step) => (
              <li class="flow-step">
                <div class="flow-step__rail" aria-hidden="true">
                  <span>{step.index}</span>
                  <i />
                </div>
                <div class="flow-step__copy">
                  <span>{step.label}</span>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                  <small>{step.note}</small>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section section--surfaces page-shell" id="surfaces">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">
            <span aria-hidden="true"></span>{t.surfaces.eyebrow}
          </p>
          <h2>{t.surfaces.title}</h2>
        </div>
        <p>{t.surfaces.intro}</p>
      </div>

      <div class="surface-grid">
        {
          t.surfaces.cards.map((card, index) => (
            <article
              class:list={["surface-card", `surface-card--${card.className}`]}
            >
              <div class="surface-card__header">
                <span>{card.kind}</span>
                <span aria-hidden="true">0{index + 1}</span>
              </div>
              <div class="surface-card__visual" aria-hidden="true">
                <span class="visual-window">
                  <>
                    <i />
                    <i />
                    <i />
                  </>
                </span>
                <span class="visual-pulse" />
              </div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <strong>
                {card.metric}
                <span aria-hidden="true"> ↗</span>
              </strong>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--integrations">
      <div class="page-shell integrations-layout">
        <div class="integrations-copy">
          <p class="eyebrow">
            <span aria-hidden="true"></span>{t.integrations.eyebrow}
          </p>
          <h2>{t.integrations.title}</h2>
          <p>{t.integrations.intro}</p>
          <a
            class="text-link"
            href={links.integrations}
            target="_blank"
            rel="noreferrer"
          >
            {t.integrations.docsAction}<span aria-hidden="true">↗</span>
          </a>
        </div>

        <div
          class="integration-table-wrap"
          role="region"
          aria-label={t.integrations.tableLabel}
          tabindex="0"
        >
          <table class="integration-table">
            <caption class="sr-only">{t.integrations.tableLabel}</caption>
            <thead>
              <tr>
                <th scope="col">{t.integrations.sourceLabel}</th>
                <th scope="col">{t.integrations.levelLabel}</th>
                <th scope="col">{t.integrations.boundaryLabel}</th>
              </tr>
            </thead>
            <tbody>
              {
                t.integrations.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.source}</th>
                    <td>
                      <span
                        class:list={["level-chip", `level-chip--${row.tone}`]}
                      >
                        {row.level}
                      </span>
                    </td>
                    <td>{row.boundary}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section--boundaries" id="boundaries">
      <div class="page-shell">
        <div class="boundary-heading">
          <p class="eyebrow eyebrow--warm">
            <span aria-hidden="true"></span>{t.boundaries.eyebrow}
          </p>
          <h2>{t.boundaries.title}</h2>
          <p>{t.boundaries.intro}</p>
        </div>

        <div class="boundary-grid">
          {
            t.boundaries.items.map((item, index) => (
              <article>
                <span aria-hidden="true">0{index + 1} / NO</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>

        <aside class="lifetime-note">
          <div class="lifetime-note__mark" aria-hidden="true">
            <span></span><i></i>
          </div>
          <div>
            <h3>{t.boundaries.dataTitle}</h3>
            <p>{t.boundaries.dataBody}</p>
            <small>{t.boundaries.previewNote}</small>
          </div>
        </aside>
      </div>
    </section>

    <section class="section section--source page-shell">
      <div class="source-card">
        <div class="source-card__brand">
          <img src="/favicon.svg" width="104" height="104" alt="" />
          <span aria-hidden="true">OPEN / LOCAL / READ-ONLY</span>
        </div>

        <div class="source-card__copy">
          <p class="eyebrow">
            <span aria-hidden="true"></span>{t.source.eyebrow}
          </p>
          <h2>{t.source.title}</h2>
          <p>{t.source.body}</p>
          <div class="source-actions">
            <a
              class="button button--primary"
              href={links.repository}
              target="_blank"
              rel="noreferrer"
            >
              {t.source.primaryAction}<span aria-hidden="true">↗</span>
            </a>
            <a
              class="button button--outlined"
              href={sourceDocsHref}
              target="_blank"
              rel="noreferrer"
            >
              {t.source.secondaryAction}
            </a>
          </div>
        </div>

        <dl class="source-meta">
          <div>
            <dt>{t.source.statusLabel}</dt>
            <dd>
              <i class="meta-dot meta-dot--candidate" aria-hidden="true"></i>{
                t.source.statusValue
              }
            </dd>
          </div>
          <div>
            <dt>{t.source.releaseLabel}</dt>
            <dd>{t.source.releaseValue}</dd>
          </div>
          <div>
            <dt>{t.source.platformLabel}</dt>
            <dd>{t.source.platformValue}</dd>
          </div>
          <div>
            <dt>{t.source.licenseLabel}</dt>
            <dd>{t.source.licenseValue}</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-shell footer-inner">
      <div class="footer-brand">
        <a class="wordmark" href={homeHref}>
          <img src="/favicon.svg" width="32" height="32" alt="" />
          <span>Crewlight</span>
        </a>
        <p>{t.footer.tagline}</p>
      </div>

      <p class="footer-status">
        <span aria-hidden="true"></span>{t.footer.status}
      </p>

      <nav class="footer-links" aria-label={t.footer.navigationLabel}>
        <a href={links.repository} target="_blank" rel="noreferrer"
          >{t.footer.source}</a
        >
        <a href={links.architecture} target="_blank" rel="noreferrer">
          {t.footer.architecture}
        </a>
        <a href={links.integrations} target="_blank" rel="noreferrer">
          {t.footer.integrations}
        </a>
        <a href={links.license} target="_blank" rel="noreferrer"
          >{t.footer.license}</a
        >
      </nav>
    </div>
  </footer>
</BaseLayout>
